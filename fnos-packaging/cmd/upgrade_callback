#!/bin/bash
# 升级后置：确保数据目录可写 + 在线构建 server (若 fpk 未内置构建产物)
set -uo pipefail

APP_NAME="${TRIM_APPNAME:-10router}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"
# 数据目录: 优先 TRIM_PKGVAR (fnOS 注入); 兜底从 APP_DIR 提取卷推导, 不写死 /vol4
APP_VOL=""
if [ -n "${TRIM_PKGVAR:-}" ]; then
    DATA_DIR="${TRIM_PKGVAR}"
else
    if [ -L "${APP_DIR}/home" ]; then
        APP_HOME="$(readlink -f "${APP_DIR}/home")"
        APP_VOL="$(printf '%s' "${APP_HOME}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
    fi
    if [ -z "${APP_VOL}" ]; then
        APP_VOL="$(printf '%s' "${APP_DIR}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
    fi
    if [ -n "${APP_VOL}" ]; then
        DATA_DIR="${APP_VOL}/@appdata/${APP_NAME}"
    else
        DATA_DIR="${APP_DIR}/var"
    fi
fi
LOG="${DATA_DIR}/install.log"

# 管理面板（issue #97）：主应用 stop 刻意不杀面板（持有定时更新调度器），
# 所以 fpk 升级后旧的.panel 进程可能还活着 —— 这里杀掉，下次 cmd/main start
# 会用新版 dashboard.js 重新拉起。
if [ -f "${DATA_DIR}/panel.pid" ]; then
    kill "$(cat "${DATA_DIR}/panel.pid")" 2>/dev/null || true
    rm -f "${DATA_DIR}/panel.pid"
    echo "[$(date '+%F %T')] panel killed for fresh relaunch" >> "${LOG}"
fi

mkdir -p "${DATA_DIR}"
echo "[$(date '+%F %T')] upgrade_callback start" >> "${LOG}"

# 定位 server 目录
SRC_DIR=""
for cand in "${APP_DIR}/server" "${APP_DIR}/target/server"; do
    [ -d "$cand" ] && SRC_DIR="$cand" && break
done
if [ -z "${SRC_DIR}" ]; then
    echo "[$(date '+%F %T')] ERROR: server dir not found (${APP_DIR}/server)" >> "${LOG}"
    exit 0
fi

# 初始登录密码：只在 ${DATA_DIR}/initial-password 不存在时才生成（0600，跨升级保留）。
# 关键点就在这里：升级时该文件已由首装留下 → 跳过 → 保留原密码，不再像旧逻辑那样每次
# 升级都往被替换的 ${SRC_DIR}/.env 里重写一个新随机口令、把依赖引导密码的用户静默锁死
# （issue #9 后续）。不再换成 123456：公开口令 + 0.0.0.0 监听 = 局域网内任何人一步
# 拿到管理员权限和全部上游凭据（issue #9）。main 从同一文件读回并作为 env 传给 node。
gen_initial_password() {
    if command -v openssl >/dev/null 2>&1; then
        openssl rand -base64 12 2>/dev/null | tr -d '/+=' | cut -c1-16
    else
        head -c 12 /dev/urandom | od -An -tx1 | tr -d ' \n'
    fi
}
PW_FILE="${DATA_DIR}/initial-password"
if [ ! -f "${PW_FILE}" ]; then
    newpw="$(gen_initial_password)"
    if [ -n "$newpw" ]; then
        ( umask 077; printf '%s\n' "${newpw}" > "${PW_FILE}" )
        echo "[$(date '+%F %T')] generated INITIAL_PASSWORD in ${PW_FILE}" >> "${LOG}"
        echo "[$(date '+%F %T')] dashboard password for the first login: ${newpw}" >> "${LOG}"
    fi
fi

# 若已含构建产物, 跳过在线构建（多路径检测）
BUILT=0
for check in "${SRC_DIR}/.next-cli-build" "${SRC_DIR}/.next" "${APP_DIR}/target/server/.next-cli-build" "${APP_DIR}/target/server/.next"; do
    if [ -d "$check" ]; then BUILT=1; break; fi
done
if [ "$BUILT" -eq 1 ]; then
    echo "[$(date '+%F %T')] server already built at ${check}; skip online build" >> "${LOG}"
    if [ ! -d "${SRC_DIR}/node_modules" ] && [ -d "${APP_DIR}/target/server/node_modules" ]; then
        ln -s "${APP_DIR}/target/server/node_modules" "${SRC_DIR}/node_modules" 2>/dev/null || true
    fi
    exit 0
fi

echo "[$(date '+%F %T')] online build: npm install + next build..." >> "${LOG}"
APP_VOL="$(printf '%s' "${DATA_DIR}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
NODE_DIR=""
for cand in /var/apps/nodejs_v24/target/bin "${APP_VOL}/@appcenter/nodejs_v24/bin"; do
    [ -x "$cand/node" ] && NODE_DIR="$cand" && break
done
if [ -z "${NODE_DIR}" ]; then
    echo "[$(date '+%F %T')] ERROR: nodejs_v24 not found; cannot build 10router" >> "${LOG}"
    exit 0
fi
export PATH="${NODE_DIR}:${PATH}"
export HOME="${DATA_DIR}"
export npm_config_jobs=1
export NODE_OPTIONS="--max-old-space-size=1024"

cd "${SRC_DIR}"
npm install --no-audit --no-fund >> "${LOG}" 2>&1
echo "[$(date '+%F %T')] npm install exit=$?" >> "${LOG}"
NEXT_DIST_DIR=.next-cli-build npm run build >> "${LOG}" 2>&1
echo "[$(date '+%F %T')] next build exit=$?" >> "${LOG}"

if [ -d "${SRC_DIR}/.next-cli-build" ]; then
    echo "[$(date '+%F %T')] online build OK" >> "${LOG}"
else
    echo "[$(date '+%F %T')] ERROR: online build did not produce .next-cli-build" >> "${LOG}"
fi

exit 0
