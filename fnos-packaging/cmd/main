#!/bin/bash
set -euo pipefail

APP_NAME="${TRIM_APPNAME:-10router}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"
# 数据目录: 优先 TRIM_PKGVAR (fnOS 注入). 兜底: 从 fnOS home 软链 (/volX/@apphome/<app>) 推导卷,
# 或从 APP_DIR 推导; 不写死具体卷. (某些 fnOS 部署 APP_DIR=/var/apps/<app> 且无 TRIM_PKGVAR)
APP_VOL=""
if [ -n "${TRIM_PKGVAR:-}" ]; then
    DATA_DIR="${TRIM_PKGVAR}"
else
    if [ -L "${APP_DIR}/home" ]; then
        APP_HOME="$(readlink -f "${APP_DIR}/home")"
        APP_VOL="$(printf '%s' "${APP_HOME}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
    fi
    if [ -z "${APP_VOL}" ]; then
        APP_VOL="$(printf '%s' "${APP_DIR}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
    fi
    if [ -n "${APP_VOL}" ]; then
        DATA_DIR="${APP_VOL}/@appdata/${APP_NAME}"
    else
        DATA_DIR="${APP_DIR}/var"
    fi
fi

# 兼容两种部署布局：
#   fnOS 传 TRIM_APPDEST=/vol4/@appcenter/10router → server 直接在 ${APP_DIR}/server
#   旧版/部分版本 TRIM_APPDEST=/var/apps/10router    → server 在 ${APP_DIR}/target/server
if [ -d "${APP_DIR}/server" ]; then
    SRC_DIR="${APP_DIR}/server"
elif [ -d "${APP_DIR}/target/server" ]; then
    SRC_DIR="${APP_DIR}/target/server"
else
    echo "ERROR: server dir not found (tried ${APP_DIR}/server and ${APP_DIR}/target/server)" >&2
    exit 1
fi

# Node.js 运行时（由 manifest install_dep_apps=nodejs_v24 提供）
APP_VOL="$(printf '%s' "${DATA_DIR}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
NODE_BIN=""
for cand in "/var/apps/nodejs_v24/target/bin/node" "${APP_VOL}/@appcenter/nodejs_v24/bin/node" "/vol4/@appcenter/nodejs_v24/bin/node"; do
  [ -x "$cand" ] && NODE_BIN="$cand" && break
done
[ -n "$NODE_BIN" ] || NODE_BIN="$(command -v node || echo /usr/bin/node)"
if [ ! -x "$NODE_BIN" ]; then
  echo "ERROR: Node.js runtime not found. Please install the 'nodejs_v24' app from the fnOS App Center." >&2
  exit 1
fi

PORT="${TRIM_SERVICE_PORT:-20127}"
HOSTNAME="0.0.0.0"
LOG="${DATA_DIR}/10router.log"
PID_FILE="${DATA_DIR}/10router.pid"

# 管理面板（issue #97）：独立进程，主应用 stop/restart 不影响它 ——
# 定时自动更新的调度器跑在这里。默认只听 127.0.0.1:20128。
PANEL_PORT="${PANEL_PORT:-20128}"
PANEL_PID_FILE="${DATA_DIR}/panel.pid"
PANEL_LOG="${DATA_DIR}/panel.log"

start() {
    mkdir -p "${DATA_DIR}"
    if [ -f "${PID_FILE}" ] && kill -0 "$(cat "${PID_FILE}")" 2>/dev/null; then
        echo "already running (pid $(cat "${PID_FILE}"))"
        return 0
    fi
    # 清理 SQLite WAL/SHM 残留（旧版/跨用户安装后属主可能错误，导致 node:sqlite 无法打开）
    rm -f "${DATA_DIR}/db/data.sqlite-shm" "${DATA_DIR}/db/data.sqlite-wal" 2>/dev/null || true
    # 初始登录密码持久化在 ${DATA_DIR}/initial-password（0600，跨 fpk 升级保留），
    # 不再写 ${SRC_DIR}/.env —— 应用负载目录在每次升级时被整体替换，密码写在那里会被
    # 抹掉并在下次启动重新生成，依赖引导密码的用户升级后被静默锁死 (issue #9 后续)。
    # 不写 JWT_SECRET —— 留空让服务端自动生成随机密钥（0600）。密码在下方作为 env 变量
    # 传给 node（env 优先级高于 .env），所以无需再写 .env。
    PW_FILE="${DATA_DIR}/initial-password"
    if [ ! -f "${PW_FILE}" ]; then
        # 首次启动: 生成随机初始密码 —— 不再写死 123456。0.0.0.0 监听 + 公开口令 =
        # 局域网内任何人一步拿到管理员权限和全部上游凭据 (issue #9)。密码只打印这一次，
        # 登录后请在 Web UI「设置」页改掉。
        GEN_PW="$("${NODE_BIN}" -e 'process.stdout.write(require("crypto").randomBytes(12).toString("base64url"))' 2>/dev/null || true)"
        if [ -z "${GEN_PW}" ]; then
            GEN_PW="$(head -c 12 /dev/urandom | od -An -tx1 | tr -d ' \n')"
        fi
        ( umask 077; printf '%s\n' "${GEN_PW}" > "${PW_FILE}" )
        echo "generated INITIAL_PASSWORD in ${PW_FILE}"
        echo "======================================================================"
        echo " dashboard password for the first login: ${GEN_PW}"
        echo " shown once — change it in the Web UI after logging in."
        echo "======================================================================"
        printf '%s generated INITIAL_PASSWORD in %s\n' "$(date '+%F %T')" "${PW_FILE}" >> "${LOG}"
    fi
    cd "${SRC_DIR}"
    # env 优先级高于 .env：把持久化的密码读回来，使同一密码在每次重启和升级后保持不变。
    # 读不到就留空 —— 服务端在「未设密码」时退回仅本机可访问，而不是放行一个公开口令。
    if [ -z "${INITIAL_PASSWORD:-}" ] && [ -f "${PW_FILE}" ]; then
        INITIAL_PASSWORD="$(head -1 "${PW_FILE}")"
    fi
    # HOME 指向数据目录：fnOS app 用户（如 10router）的 /home/<app> 未必存在，
    # 而 9router 源码会 mkdirSync($HOME/.9router) 存 usage/log，指向不存在的目录会 EACCES
    # INSTALL_CHANNEL=fpk：仪表盘「检查更新」据此显示对应版本 Releases
    # 下载入口，而不是 npm 全局安装命令（对 fpk 用户是错误指引）。
    DATA_DIR="${DATA_DIR}" PORT="${PORT}" HOSTNAME="${HOSTNAME}" HOME="${DATA_DIR}" \
        INITIAL_PASSWORD="${INITIAL_PASSWORD}" INSTALL_CHANNEL="fpk" \
        nohup "${NODE_BIN}" --max-old-space-size=4096 custom-server.js >> "${LOG}" 2>&1 &
    echo $! > "${PID_FILE}"
    # 等待服务就绪（最多 60s）
    for i in $(seq 1 60); do
        if curl -sf "http://127.0.0.1:${PORT}/api/health" >/dev/null 2>&1; then
            echo "started (pid $(cat "${PID_FILE}"))"
            APP_DIR="${APP_DIR}" DATA_DIR="${DATA_DIR}" SRC_DIR="${SRC_DIR}" NODE_BIN="${NODE_BIN}" MAIN_PORT="${PORT}" \
                PANEL_PORT="${PANEL_PORT}" start_panel
            return 0
        fi
        sleep 1
    done
    echo "started, but health check timed out (check ${LOG})"
    return 0
}

start_panel() {
    # 主应用健康后再拉起面板；面板挂了不影响主应用，主应用重启也不打断面板调度。
    if [ -f "${PANEL_PID_FILE}" ] && kill -0 "$(cat "${PANEL_PID_FILE}")" 2>/dev/null; then
        return 0
    fi
    # 面板是 fpk cmd/ 的一部分，不随 server 产物热覆盖而变化 —— 用本脚本目录里的副本。
    ( umask 077; nohup "${NODE_BIN}" "${APP_DIR}/cmd/dashboard.js" >> "${PANEL_LOG}" 2>&1 & echo $! > "${PANEL_PID_FILE}" )
}

stop_panel() {
    if [ -f "${PANEL_PID_FILE}" ]; then
        kill "$(cat "${PANEL_PID_FILE}")" 2>/dev/null || true
        rm -f "${PANEL_PID_FILE}"
    fi
}

stop() {
    if [ -f "${PID_FILE}" ]; then
        kill "$(cat "${PID_FILE}")" 2>/dev/null || true
        rm -f "${PID_FILE}"
    fi
    # 兜底：杀掉残留的 next-server 进程（仅限本应用目录）
    pkill -f "${SRC_DIR}/custom-server.js" 2>/dev/null || true
    # 注意：这里刻意不杀管理面板（panel.pid）——面板持有定时自动更新的调度器，
    # 且更新流程自身会调用 `cmd/main restart`；若 restart 连带杀面板，编排
    # （含失败回滚）会在半途死亡。面板随应用卸载时才清理（见 cmd/uninstall_init）。
    echo "stopped"
}

status() {
    if [ -f "${PID_FILE}" ] && kill -0 "$(cat "${PID_FILE}")" 2>/dev/null; then
        echo "running"
        return 0
    fi
    echo "stopped"
    return 1
}

case "${1:-start}" in
    start) start ;;
    stop) stop ;;
    status) status ;;
    restart) stop; sleep 1; start ;;
    *) echo "Usage: $0 {start|stop|status|restart}"; exit 1 ;;
esac
